# Sao chép file này thành ".env" rồi chỉnh theo máy của bạn:
#   Windows (cmd):        copy .env.example .env
#   Windows (PowerShell): Copy-Item .env.example .env
#   Linux/macOS:          cp .env.example .env

# Địa chỉ MongoDB (khớp với docker-compose.yml)
MONGO_URI=mongodb://localhost:27017
# Tên database
DB_NAME=ecommerce
# Đường dẫn file CSV (tính từ thư mục gốc dự án)
CSV_PATH=data/raw/2019-Oct.csv
# Phần trăm người dùng được nạp (1-100). Giữ dòng có user_id % 100 < giá trị này.
# 100 = lấy hết. Máy RAM 8GB nên để 10-20.
SAMPLE_PERCENT=100
# Số dòng CSV đọc mỗi lượt khi nạp dữ liệu (giảm xuống nếu thiếu RAM)
CHUNK_SIZE=500000
# Số tương tác tối thiểu của một người dùng để được đưa vào huấn luyện
MIN_USER_INTERACTIONS=2
